      ],
      "additionalProperties": false
    },
    "polygon": {
      "description": "Closes automatically; appending the first point is unnecessary. Runtime accepts one terminal copy of the first point, preserves the source list, and excludes only that marker for validation. The effective contour needs at least three points, no adjacent duplicates including last-to-first, and exact noncollinearity over decoded binary64 coordinates without tolerance, using the first point and the first different point as a baseline. Zero signed area alone does not establish degeneracy. Further duplicates are not removed.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
