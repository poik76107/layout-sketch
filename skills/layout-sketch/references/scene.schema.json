            "thick",
            "thin"
          ],
          "default": "thick"
        },
        "fill": {
          "enum": [
            "none",
            "white",
            "black"
          ],
          "default": "none"
        },
        "type": {
          "const": "polygon"
        },
        "pts": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3
        }
      },
      "required": [
        "type",
        "pts"
      ],
      "additionalProperties": false
    },
