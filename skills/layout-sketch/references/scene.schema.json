{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sketch scene schema 1 (sketch 0.1.x)",
  "description": "Structural contract. Runtime first decodes numbers to finite binary64 with rounding, then checks domains, schema_version equality and count integrality/range on decoded values rather than exact decimal tokens. Integral spellings and tokens rounded to permitted values are accepted; overflow to infinity is rejected. Runtime additionally validates geometry, ids, duplicate keys, path grammar and expansion limits, and rendering requires representable intermediate and transformed coordinates. Runtime limits each outward-rounded painted path extent after transforms and stroke expansion to 16777216 pixels per axis inclusive, checking every stroke outline and source paths with white or black fill; allow_clip does not bypass it.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "canvas": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ],
      "default": "landscape"
    },
    "shapes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/primitive"
          },
          {
            "$ref": "#/$defs/group"
          },
          {
            "$ref": "#/$defs/repeat_rotate"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "shapes"
  ],
  "additionalProperties": false,
  "$defs": {
    "line": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "allow_clip": {
          "type": "array",
          "items": {
            "enum": [
              "left",
              "top",
              "right",
              "bottom"
            ]
          },
          "uniqueItems": true,
          "maxItems": 4,
          "default": []
        },
        "width": {
          "enum": [
            "thick",
            "thin"
          ],
          "default": "thick"
        },
        "fill": {
          "const": "none",
          "default": "none"
        },
        "type": {
          "const": "line"
        },
        "from": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "to": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "angle": {
          "type": "number"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "from"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "to"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "angle"
                ]
              },
              {
                "required": [
                  "length"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "angle",
            "length"
          ],
          "not": {
            "required": [
              "to"
            ]
          }
        }
      ]
    },
